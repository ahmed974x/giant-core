# Copy to .env and fill every secret with:  openssl rand -hex 32
# Never commit .env.

# Encrypts every credential n8n stores. Losing it = re-entering credentials.
N8N_ENCRYPTION_KEY=
# Shared secret n8n sends to the relay (X-Omega-Token). 32+ chars.
OMEGA_RELAY_TOKEN=

# Timescale superuser, the n8n write-only role, and PostgREST's read-only login.
POSTGRES_PASSWORD=
SENTINEL_DB_PASSWORD=
PGRST_DB_PASSWORD=
# Signs the cortex gateway's write token for its performance log. 32+ chars.
PGRST_JWT_SECRET=

# ── Cortex LLM gateway ──────────────────────────────────────────────────
# Bearer token for http://localhost:8089/v1 (used by the dashboard's relay and n8n's news scorer). 32+ chars.
OMEGA_GATEWAY_TOKEN=
# Claude (paid, used only by the omega/smart and claude routes). https://console.anthropic.com/settings/keys
# Paste it here, unquoted:  ANTHROPIC_API_KEY=sk-ant-...   (MODEL_API_KEY=sk-ant-... also works)
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5) and effort (low|medium|high|xhigh|max).
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Free tiers. Each provider switches on when its key is set. Key pages:
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/app/apikey   (free tier may train on prompts)
GEMINI_API_KEY=
# https://console.mistral.ai/api-keys      (free mode may train unless you opt out)
MISTRAL_API_KEY=
# https://dash.cloudflare.com/profile/api-tokens  (Workers AI permission)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://openrouter.ai/keys              (free models may log prompts)
OPENROUTER_API_KEY=
# https://z.ai  (international) / open.bigmodel.cn
ZAI_API_KEY=
# https://ollama.com/settings/keys
OLLAMA_API_KEY=
# https://token.llm7.io  (optional, raises limits)
LLM7_API_KEY=
# Keyless providers (LLM7, OVHcloud, Kilo) may log prompts. Off unless you say so.
OMEGA_ALLOW_ANON_PROVIDERS=false
# Open-source local model (Ollama, MIT) inside the stack: free, no quota, private, the last fallback
# of every route. Pick any model from https://ollama.com/library that fits your RAM
# (default llama3.2:3b is a ~2 GB download, capped by OLLAMA_MEM_LIMIT=2560m; qwen3:8b needs ~6 GB and will not fit
# a 7 GB laptop). It only runs with: docker compose --profile llm up -d. Leave OMEGA_LOCAL_LLM_URL empty to turn it off.
OMEGA_LOCAL_MODEL=llama3.2:3b
OMEGA_LOCAL_LLM_URL=http://ollama:11434/v1

# Telegram alerts (optional; the node stays disabled until both are set).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Whale Watch chain sources (free, no key). Any Ethereum JSON-RPC that accepts batches works,
# e.g. an Alchemy/Infura free-tier URL. Changing these needs a re-seed (see README).
OMEGA_BTC_API=https://blockchain.info
OMEGA_ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Pairs the relay accepts. BTCUSDT and ETHUSDT also price Whale Watch, so keep them. Keep in sync with SYMBOLS in the n8n "Plan requests" node.
OMEGA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TZ=Asia/Kuwait

# ── Supabase cloud mirror (optional, docker compose --profile cloud) ──────────────────────────
# Project URL and a SECRET key (Project Settings → API Keys → sb_secret_…). The key stays on this
# laptop and is only used by cloud-sync to write; apply supabase/migrations/*.sql to the project first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Geospatial store (optional, docker compose --profile geo) ─────────────────────────────────
# PostGIS password for the omega_geo database. Generate one:  openssl rand -hex 32
GEO_DB_PASSWORD=

# ── Director 00 memory (optional, docker compose --profile director) ──────────────────────────
# Postgres + pgvector for agent_memories and the approval ledger. Generate:  openssl rand -hex 32
DIRECTOR_DB_PASSWORD=
# Director 00 connects from the host. Leave DIRECTOR_DB_URL empty to use the in-process store (no Docker).
DIRECTOR_DB_URL=postgresql://omega_director:${DIRECTOR_DB_PASSWORD}@127.0.0.1:5435/omega_memory
# Embeddings: "hashing" (built in, no model, 384-d) or an OpenAI-compatible endpoint such as Ollama:
#   DIRECTOR_EMBED_URL=http://127.0.0.1:11434/v1   DIRECTOR_EMBED_MODEL=all-minilm   (384-d)
DIRECTOR_EMBED_URL=
DIRECTOR_EMBED_MODEL=
# Planner LLM: any OpenAI-compatible endpoint (Cortex at http://127.0.0.1:8088/llm is not public; Ollama works).
# Empty = rule-based planner, still fully approval-gated.
DIRECTOR_LLM_URL=
DIRECTOR_LLM_MODEL=

# ── SwissPipe workflow runner (optional, docker compose --profile swisspipe; ADR 015) ──────────────
# Admin login for the localhost:3700 UI/API. Never leave the image defaults (admin/admin).
SWISSPIPE_USERNAME=
SWISSPIPE_PASSWORD=

# ── maritime-agent (local-first) ───────────────────────────────────────────────────────────────
# SQLite store used until PostGIS is up. Leave empty for services/maritime-agent/data/maritime.sqlite.
MARITIME_DB_PATH=
# Live public AIS feed for later (free key at https://aisstream.io). Empty = use simulate_ais.py.
AISSTREAM_API_KEY=

# ── Speed metrics (optional, docker compose --profile metrics) ─────────────────────────────────
# Grafana admin password (http://localhost:3000, user admin). Generate one:  openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# Immich photo library (ADR-030), docker compose --profile photos up -d. Strong random password.
IMMICH_DB_PASSWORD=
# Where photos are stored (default ./data/immich, git-ignored)
IMMICH_UPLOAD_LOCATION=./data/immich
