# Copy to .env and fill every secret with:  openssl rand -hex 32
# Never commit .env.

# Encrypts every credential n8n stores. Losing it = re-entering credentials.
N8N_ENCRYPTION_KEY=
# Shared secret n8n sends to the relay (X-Omega-Token). 32+ chars.
OMEGA_RELAY_TOKEN=

# Timescale superuser, the n8n write-only role, and PostgREST's read-only login.
POSTGRES_PASSWORD=
SENTINEL_DB_PASSWORD=
PGRST_DB_PASSWORD=
# Signs the cortex gateway's write token for its performance log. 32+ chars.
PGRST_JWT_SECRET=

# ── Cortex LLM gateway ──────────────────────────────────────────────────
# Bearer token for http://localhost:8089/v1 (and what the dashboard's relay uses). 32+ chars.
OMEGA_GATEWAY_TOKEN=
# Claude (paid, used only by the omega/smart and claude routes). https://console.anthropic.com/settings/keys
# Paste it here, unquoted:  ANTHROPIC_API_KEY=sk-ant-...   (MODEL_API_KEY=sk-ant-... also works)
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5) and effort (low|medium|high|xhigh|max).
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Free tiers. Each provider switches on when its key is set. Key pages:
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/app/apikey   (free tier may train on prompts)
GEMINI_API_KEY=
# https://console.mistral.ai/api-keys      (free mode may train unless you opt out)
MISTRAL_API_KEY=
# https://dash.cloudflare.com/profile/api-tokens  (Workers AI permission)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://openrouter.ai/keys              (free models may log prompts)
OPENROUTER_API_KEY=
# https://z.ai  (international) / open.bigmodel.cn
ZAI_API_KEY=
# https://ollama.com/settings/keys
OLLAMA_API_KEY=
# https://token.llm7.io  (optional, raises limits)
LLM7_API_KEY=
# Keyless providers (LLM7, OVHcloud, Kilo) may log prompts. Off unless you say so.
OMEGA_ALLOW_ANON_PROVIDERS=false
# Open-source local model (Ollama, MIT) inside the stack: free, no quota, private, the last fallback
# of every route. Pick any model from https://ollama.com/library that fits your RAM
# (default llama3.2:3b is a ~2 GB download, ~3 GB RAM, capped by OLLAMA_MEM_LIMIT=4g; qwen3:8b needs ~6 GB). Leave OMEGA_LOCAL_LLM_URL empty to turn it off.
OMEGA_LOCAL_MODEL=llama3.2:3b
OMEGA_LOCAL_LLM_URL=http://ollama:11434/v1

# Telegram alerts (optional; the node stays disabled until both are set).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pairs the relay accepts. Keep in sync with SYMBOLS in the n8n "Plan requests" node.
OMEGA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TZ=Asia/Kuwait
