# Copy to .env and fill every secret with:  openssl rand -hex 32
# Never commit .env.

# Encrypts every credential n8n stores. Losing it = re-entering credentials.
N8N_ENCRYPTION_KEY=
# Shared secret n8n sends to the relay (X-Omega-Token). 32+ chars.
OMEGA_RELAY_TOKEN=

# Timescale superuser, the n8n write-only role, and PostgREST's read-only login.
POSTGRES_PASSWORD=
SENTINEL_DB_PASSWORD=
PGRST_DB_PASSWORD=

# Telegram alerts (optional; the node stays disabled until both are set).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Whale Watch chain sources (free, no key). Any Ethereum JSON-RPC that accepts batches works,
# e.g. an Alchemy/Infura free-tier URL. Changing these needs a re-seed (see README).
OMEGA_BTC_API=https://blockchain.info
OMEGA_ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Pairs the relay accepts. BTCUSDT and ETHUSDT also price Whale Watch, so keep them. Keep in sync with SYMBOLS in the n8n "Plan requests" node.
OMEGA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TZ=Asia/Kuwait
