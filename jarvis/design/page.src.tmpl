<div class="app" id="app">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="brand"><svg class="i" aria-hidden="true"><use href="#i-mark"/></svg><span class="brand-word" translate="no">Jarvis</span></div>
    <nav aria-label="Main">
      <ul class="nav" id="nav">
        <li><a href="#overview" aria-current="page"><svg class="i" aria-hidden="true"><use href="#i-home"/></svg><span class="nav-label">Overview</span></a></li>
        <li><a href="#agents"><svg class="i" aria-hidden="true"><use href="#i-agent"/></svg><span class="nav-label">Agents</span></a></li>
        <li><a href="#workflows"><svg class="i" aria-hidden="true"><use href="#i-flow"/></svg><span class="nav-label">Workflows</span></a></li>
        <li><a href="#runs"><svg class="i" aria-hidden="true"><use href="#i-run"/></svg><span class="nav-label">Runs</span></a></li>
        <li><a href="#approvals"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><span class="nav-label">Approvals</span><span class="count num" aria-label="2 waiting">2</span></a></li>
        <li><a href="#logs"><svg class="i" aria-hidden="true"><use href="#i-logs"/></svg><span class="nav-label">Logs</span></a></li>
      </ul>
      <p class="nav-group">System</p>
      <ul class="nav">
        <li><a href="#foundations"><svg class="i" aria-hidden="true"><use href="#i-gear"/></svg><span class="nav-label">Design system</span></a></li>
      </ul>
    </nav>
    <div class="sidebar-foot">
      <button class="btn btn-ghost collapse-btn" id="collapse" type="button" aria-controls="sidebar" aria-expanded="true">
        <svg class="i" aria-hidden="true"><use href="#i-panel"/></svg><span class="nav-label">Collapse</span>
      </button>
    </div>
  </aside>
  <div class="scrim" id="scrim" hidden></div>

  <div class="main-col">
    <header class="topbar">
      <button class="btn btn-ghost btn-icon menu-btn" id="menu" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false"><svg class="i" aria-hidden="true"><use href="#i-menu"/></svg></button>
      <div class="ws">
        <button class="btn btn-ghost" id="wsBtn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="wsMenu"><span class="ws-name" id="wsName">Personal</span><svg class="i" aria-hidden="true"><use href="#i-chev"/></svg></button>
        <ul class="ws-menu" id="wsMenu" role="menu" aria-label="Workspaces" hidden>
          <li role="menuitemradio" aria-checked="true" tabindex="-1">Personal</li>
          <li role="menuitemradio" aria-checked="false" tabindex="-1">Research lab</li>
        </ul>
      </div>
      <button class="btn btn-secondary search-trigger" id="searchBtn" type="button" aria-label="Search (Ctrl+K)" aria-haspopup="dialog">
        <span class="row"><svg class="i" aria-hidden="true"><use href="#i-search"/></svg><span class="search-word">Search…</span></span><span class="kbd" id="kbdHint">Ctrl K</span>
      </button>
      <span class="spacer"></span>
      <button class="btn btn-ghost btn-icon" id="dirBtn" type="button" aria-label="Switch to right-to-left layout"><svg class="i" aria-hidden="true"><use href="#i-dir"/></svg></button>
      <button class="btn btn-ghost btn-icon" id="themeBtn" type="button" aria-label="Switch to light theme"><svg class="i" aria-hidden="true"><use href="#i-sun" id="themeIcon"/></svg></button>
    </header>

    <main id="main" tabindex="-1">
      <div class="page-head">
        <h1 dir="auto">Design system</h1>
        <p class="muted" dir="auto">Every Jarvis primitive in every state. Switch theme and direction from the top bar.</p>
        <p class="sample-note" dir="auto"><svg class="i" aria-hidden="true"><use href="#i-alert"/></svg>Design sample — placeholder data. Nothing here is live.</p>
      </div>

      <section class="block" id="foundations" aria-labelledby="h-colours">
        <h2 id="h-colours">Colour roles</h2>
        <div class="swatches" id="swatches"></div>
      </section>

      <section class="block" aria-labelledby="h-type">
        <h2 id="h-type">Type</h2>
        <div class="card"><div class="card-in" id="typeRows"></div></div>
      </section>

      <section class="block" aria-labelledby="h-buttons">
        <h2 id="h-buttons">Buttons</h2>
        <div class="card"><div class="card-in stack">
          <div class="row">
            <button class="btn btn-primary" type="button">Run agent</button>
            <button class="btn btn-secondary" type="button">Edit</button>
            <button class="btn btn-ghost" type="button">Cancel</button>
            <button class="btn btn-danger" type="button" id="dangerBtn">Delete agent</button>
            <button class="btn btn-secondary btn-icon" type="button" aria-label="Search"><svg class="i" aria-hidden="true"><use href="#i-search"/></svg></button>
          </div>
          <div class="row">
            <button class="btn btn-primary btn-sm" type="button">Small</button>
            <button class="btn btn-primary" type="button">Medium</button>
            <button class="btn btn-primary btn-lg" type="button">Large</button>
            <button class="btn btn-primary" type="button" disabled>Disabled</button>
            <button class="btn btn-primary" type="button" id="saveBtn">Save changes</button>
          </div>
        </div></div>
      </section>

      <section class="block" aria-labelledby="h-fields">
        <h2 id="h-fields">Fields</h2>
        <div class="grid-2">
          <div class="card"><div class="card-in stack">
            <div class="field"><label for="f-name">Agent name</label><input class="input" id="f-name" name="agent-name" autocomplete="off" placeholder="Research assistant" /><span class="hint">Shown in lists and run logs.</span></div>
            <div class="field"><label for="f-search">Search agents</label><div class="with-icon"><svg class="i" aria-hidden="true"><use href="#i-search"/></svg><input class="input" id="f-search" name="q" type="search" autocomplete="off" placeholder="Name, model or tool" /></div></div>
            <div class="field"><label for="f-key">Model key</label><div class="secret"><input class="input" id="f-key" name="model-key" type="password" autocomplete="off" value="placeholder-value" /><button class="btn btn-secondary btn-icon" type="button" id="revealBtn" aria-label="Show value" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-eye"/></svg></button></div><span class="hint">Stored only in the encrypted vault.</span></div>
            <div class="field"><label for="f-limit">Max steps per run</label><input class="input num" id="f-limit" name="max-steps" inputmode="numeric" autocomplete="off" value="0" aria-invalid="true" aria-describedby="f-limit-err" /><span class="err" id="f-limit-err"><svg class="i" aria-hidden="true"><use href="#i-alert"/></svg>Enter a number from 1 to 200.</span></div>
          </div></div>
          <div class="card"><div class="card-in stack">
            <div class="field"><label for="f-model">Model</label><select class="select" id="f-model" name="model" autocomplete="off"><option>Local model (loopback)</option><option>Hosted model</option></select></div>
            <div class="field"><label for="f-role">Role prompt</label><textarea class="textarea" id="f-role" name="role" autocomplete="off" placeholder="What this agent does, and what it must never do."></textarea></div>
            <div class="field"><label for="f-dis">Workspace</label><input class="input" id="f-dis" name="workspace" autocomplete="off" value="Personal" disabled /></div>
            <fieldset><legend class="legend">Tools</legend>
              <label class="check"><input type="checkbox" name="tool-web" checked /> Read public web pages</label>
              <label class="check"><input type="checkbox" name="tool-files" /> Read project files</label>
              <label class="check switch"><input type="checkbox" role="switch" name="approval" checked /> Ask before acting outside the sandbox</label>
              <label class="check switch"><input type="checkbox" role="switch" name="money" disabled /> Move money (locked)</label>
            </fieldset>
          </div></div>
        </div>
      </section>

      <section class="block" aria-labelledby="h-tabs">
        <h2 id="h-tabs">Tabs</h2>
        <div class="card"><div class="card-in">
          <div class="tablist" role="tablist" aria-label="Agent sections" id="tabs">
            <button class="tab" role="tab" id="t-1" aria-controls="p-1" aria-selected="true" type="button">Config</button>
            <button class="tab" role="tab" id="t-2" aria-controls="p-2" aria-selected="false" tabindex="-1" type="button">Tools</button>
            <button class="tab" role="tab" id="t-3" aria-controls="p-3" aria-selected="false" tabindex="-1" type="button">Runs</button>
          </div>
          <div class="tabpanel" role="tabpanel" id="p-1" aria-labelledby="t-1" tabindex="0">Name, role prompt, model and limits.</div>
          <div class="tabpanel" role="tabpanel" id="p-2" aria-labelledby="t-2" tabindex="0" hidden>Each tool the agent may call, with its scope.</div>
          <div class="tabpanel" role="tabpanel" id="p-3" aria-labelledby="t-3" tabindex="0" hidden>Recent runs with status, time and cost.</div>
        </div></div>
      </section>

      <section class="block" aria-labelledby="h-status">
        <h2 id="h-status">Status</h2>
        <div class="row" id="badges"></div>
      </section>

      <section class="block" id="overview" aria-labelledby="h-overview">
        <h2 id="h-overview">Overview tiles</h2>
        <div class="stats">
          <div class="stat"><span class="label">Active agents</span><span class="value num">4</span><span class="delta s-ok">▲ 1 since yesterday</span></div>
          <div class="stat"><span class="label">Runs today</span><span class="value num">27</span><span class="delta muted">Same as yesterday</span></div>
          <div class="stat"><span class="label">Waiting for approval</span><span class="value num s-approval">2</span><span class="delta muted">Oldest 14 min</span></div>
          <div class="stat"><span class="label">Failed runs</span><span class="value num s-failed">1</span><span class="delta s-failed">▲ 1 since yesterday</span></div>
        </div>
      </section>

      <section class="block" id="agents" aria-labelledby="h-agents">
        <h2 id="h-agents">Agents table</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="h-agents">
          <table>
            <thead><tr><th scope="col">Agent</th><th scope="col">Status</th><th scope="col">Model</th><th scope="col" class="right">Runs</th><th scope="col">Last run</th></tr></thead>
            <tbody id="agentRows"></tbody>
          </table>
        </div>
      </section>

      <section class="block" id="runs" aria-labelledby="h-run">
        <h2 id="h-run">Run timeline</h2>
        <div class="grid-2">
          <div class="card"><ol class="timeline" id="steps"></ol></div>
          <pre class="log" id="logs" aria-label="Run log" tabindex="0"></pre>
        </div>
      </section>

      <section class="block" id="approvals" aria-labelledby="h-approvals">
        <h2 id="h-approvals">Approvals</h2>
        <div class="grid-2">
          <article class="approval" aria-labelledby="a1-title">
            <div class="row"><span class="badge s-approval"><span class="dot" aria-hidden="true"></span>Awaiting approval</span><span class="subtle t-caption">Research assistant · 14 min ago</span></div>
            <h3 id="a1-title">Write a summary file to the project folder</h3>
            <pre class="diff"><span class="add">+ notes/weekly-summary.md (2.1 KB)</span>
<span class="del">- notes/draft.md</span></pre>
            <div class="row"><button class="btn btn-primary" type="button" id="approveBtn">Approve</button><button class="btn btn-secondary" type="button" id="rejectBtn">Reject…</button></div>
          </article>
          <article class="approval locked" aria-labelledby="a2-title">
            <div class="row"><span class="badge s-approval"><svg class="i" aria-hidden="true"><use href="#i-lock"/></svg>قيد الموافقة</span></div>
            <h3 id="a2-title">Move money or place an order</h3>
            <p class="muted t-sm">Locked. Jarvis cannot approve this. It needs Director 00's separate approval, a legal review and a security review.</p>
          </article>
        </div>
      </section>

      <section class="block" id="workflows" aria-labelledby="h-empty">
        <h2 id="h-empty">Empty and loading</h2>
        <div class="grid-2">
          <div class="empty"><svg class="i" aria-hidden="true"><use href="#i-inbox"/></svg><h3>No workflows yet</h3><p class="muted t-sm">A workflow chains agents into steps you can run again.</p><button class="btn btn-primary" type="button">New workflow</button></div>
          <div class="skel" aria-busy="true" aria-label="Loading"><div class="sk h32"></div><div class="sk w80"></div><div class="sk w60"></div><div class="sk w40"></div></div>
        </div>
      </section>

      <section class="block" id="logs-sec" aria-labelledby="h-feedback">
        <h2 id="h-feedback">Feedback</h2>
        <div class="row" id="logsAnchor">
          <button class="btn btn-secondary" type="button" data-toast="info">Info toast</button>
          <button class="btn btn-secondary" type="button" data-toast="ok">Success toast</button>
          <button class="btn btn-secondary" type="button" data-toast="retry">Warning toast</button>
          <button class="btn btn-secondary" type="button" data-toast="failed">Error toast</button>
          <button class="btn btn-secondary" type="button" id="paletteBtn2">Command palette</button>
        </div>
      </section>
    </main>
  </div>
</div>

<dialog id="confirm" aria-labelledby="confirm-title">
  <div class="dlg">
    <h2 id="confirm-title">Delete “Research assistant”?</h2>
    <p class="muted t-sm">Its configuration and run history are removed. Runs already finished stay in the audit log.</p>
    <div class="actions"><button class="btn btn-secondary" type="button" data-close>Keep agent</button><button class="btn btn-danger" type="button" data-close data-done="Agent deleted (design sample).">Delete agent</button></div>
  </div>
</dialog>

<dialog id="reject" aria-labelledby="reject-title">
  <div class="dlg">
    <h2 id="reject-title">Reject this action</h2>
    <div class="field"><label for="f-reason">Reason</label><textarea class="textarea" id="f-reason" name="reason" autocomplete="off" placeholder="Tell the agent what to do instead."></textarea></div>
    <div class="actions"><button class="btn btn-secondary" type="button" data-close>Back</button><button class="btn btn-primary" type="button" data-close data-done="Action rejected (design sample).">Reject</button></div>
  </div>
</dialog>

<dialog id="palette" class="palette" aria-label="Command palette">
  <div class="pal-in">
    <svg class="i" aria-hidden="true"><use href="#i-search"/></svg>
    <input id="palInput" type="text" name="command" autocomplete="off" placeholder="Jump to a page or run an action…" role="combobox" aria-expanded="true" aria-controls="palList" aria-autocomplete="list" aria-label="Command" />
  </div>
  <ul id="palList" role="listbox" aria-label="Results"></ul>
  <p class="none" id="palNone" hidden>No match. Try an agent, page or action name.</p>
</dialog>

<div class="toasts" id="toasts" role="status" aria-live="polite"></div>

<script>
(() => {
  "use strict";
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const root = document.documentElement;
  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* storage off: page still works */ } }
  };
  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
  const icon = id => { const ns = "http://www.w3.org/2000/svg"; const s = document.createElementNS(ns, "svg"); s.setAttribute("class", "i"); s.setAttribute("aria-hidden", "true"); const u = document.createElementNS(ns, "use"); u.setAttribute("href", "#" + id); s.appendChild(u); return s; };

  /* Theme: dark by default; light is a toggle. Falls back to the suite's stored theme. */
  const themeBtn = $("#themeBtn"), themeIcon = $("#themeIcon");
  function applyTheme(t) {
    if (t === "light") root.setAttribute("data-theme", "light"); else root.removeAttribute("data-theme");
    const light = t === "light";
    themeBtn.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
    themeIcon.setAttribute("href", light ? "#i-moon" : "#i-sun");
  }
  applyTheme(store.get("jarvis-theme") || store.get("omega-theme") || "dark");
  themeBtn.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    applyTheme(next); store.set("jarvis-theme", next); swatches();
  });

  /* Direction: LTR now, RTL ready. */
  const dirBtn = $("#dirBtn");
  function applyDir(d) {
    root.dir = d === "rtl" ? "rtl" : "ltr";
    dirBtn.setAttribute("aria-label", d === "rtl" ? "Switch to left-to-right layout" : "Switch to right-to-left layout");
  }
  applyDir(store.get("jarvis-dir") || "ltr");
  dirBtn.addEventListener("click", () => { const d = root.dir === "rtl" ? "ltr" : "rtl"; applyDir(d); store.set("jarvis-dir", d); });

  /* Sidebar: collapse to rail (desktop), drawer (phone). */
  const app = $("#app"), collapse = $("#collapse"), menu = $("#menu"), scrim = $("#scrim");
  if (store.get("jarvis-rail") === "1") { app.classList.add("rail"); collapse.setAttribute("aria-expanded", "false"); }
  collapse.addEventListener("click", () => {
    const rail = app.classList.toggle("rail");
    collapse.setAttribute("aria-expanded", String(!rail));
    collapse.querySelector(".nav-label").textContent = rail ? "Expand" : "Collapse";
    store.set("jarvis-rail", rail ? "1" : "0");
  });
  function drawer(open) {
    app.classList.toggle("drawer-open", open);
    scrim.hidden = !open;
    menu.setAttribute("aria-expanded", String(open));
    if (open) $("#nav a").focus(); else menu.focus();
  }
  menu.addEventListener("click", () => drawer(true));
  scrim.addEventListener("click", () => drawer(false));
  $$(".nav a").forEach(a => a.addEventListener("click", () => {
    $$(".nav a").forEach(x => x.removeAttribute("aria-current"));
    a.setAttribute("aria-current", "page");
    if (app.classList.contains("drawer-open")) drawer(false);
  }));

  /* Workspace switcher: APG menu button. */
  const wsBtn = $("#wsBtn"), wsMenu = $("#wsMenu"), wsItems = $$("[role=menuitemradio]", wsMenu);
  function wsOpen(open, focusIdx) {
    wsMenu.hidden = !open; wsBtn.setAttribute("aria-expanded", String(open));
    if (open) wsItems[focusIdx || 0].focus();
  }
  wsBtn.addEventListener("click", () => wsOpen(wsMenu.hidden));
  wsBtn.addEventListener("keydown", e => { if (e.key === "ArrowDown") { e.preventDefault(); wsOpen(true, 0); } });
  wsItems.forEach((it, i) => {
    const pick = () => { wsItems.forEach(x => x.setAttribute("aria-checked", "false")); it.setAttribute("aria-checked", "true"); $("#wsName").textContent = it.textContent; wsOpen(false); wsBtn.focus(); };
    it.addEventListener("click", pick);
    it.addEventListener("keydown", e => {
      if (e.key === "ArrowDown") { e.preventDefault(); wsItems[(i + 1) % wsItems.length].focus(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); wsItems[(i - 1 + wsItems.length) % wsItems.length].focus(); }
      else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); }
      else if (e.key === "Escape" || e.key === "Tab") { wsOpen(false); wsBtn.focus(); }
    });
  });
  document.addEventListener("click", e => { if (!wsMenu.hidden && !e.target.closest(".ws")) wsOpen(false); });

  /* Colour roles, read from the live tokens. */
  const ROLES = ["bg", "surface", "surface-raised", "surface-sunken", "border", "border-input", "text", "text-muted", "text-subtle", "accent", "accent-hover", "on-accent", "focus", "danger", "success", "warning", "info", "approval", "glass", "glass-rim", "glass-edge"];
  function swatches() {
    const box = $("#swatches"); box.replaceChildren();
    const cs = getComputedStyle(root);
    ROLES.forEach(r => {
      const s = el("div", "swatch"), chip = el("span", "chip"), meta = el("div");
      chip.style.background = "var(--color-" + r + ")";
      meta.append(el("b", null, r), el("span", "mono", cs.getPropertyValue("--color-" + r).trim()));
      s.append(chip, meta); box.appendChild(s);
    });
  }
  swatches();

  /* Type scale. */
  [["caption", "12 / 16 · 500", "Table headers and meta"], ["sm", "13 / 20 · 400", "Dense tables and sidebar items"], ["base", "15 / 22 · 400", "Body text for descriptions and forms"], ["headline", "17 / 24 · 600", "Card titles"], ["title", "22 / 28 · 650", "Page titles"], ["display", "32 / 38 · 700", "1,284"]].forEach(([k, spec, sample]) => {
    const row = el("div", "type-row");
    const lab = el("div"); lab.append(el("b", "t-caption", k), el("div", "t-caption subtle mono", spec));
    const s = el("div", "t-" + k + (k === "display" ? " num" : ""), sample);
    row.append(lab, s); $("#typeRows").appendChild(row);
  });

  /* Status badges. */
  const STATUS = [["s-idle", "Idle"], ["s-running", "Running"], ["s-ok", "Succeeded"], ["s-failed", "Failed"], ["s-queued", "Queued"], ["s-retry", "Retrying"], ["s-approval", "Awaiting approval"], ["s-paused", "Paused"]];
  const badge = (cls, text) => { const b = el("span", "badge " + cls); const d = el("span", "dot"); d.setAttribute("aria-hidden", "true"); b.append(d, document.createTextNode(text)); return b; };
  STATUS.forEach(([c, t]) => $("#badges").appendChild(badge(c, t)));

  /* Sample agents (placeholder data). */
  const fmt = new Intl.NumberFormat("en");
  [["Research assistant", "s-running", "Running", "Local model", 128, "now"], ["Inbox triage", "s-ok", "Succeeded", "Local model", 342, "6 min ago"], ["Weekly report", "s-approval", "Awaiting approval", "Hosted model", 19, "14 min ago"], ["Docs indexer", "s-failed", "Failed", "Local model", 57, "1 h ago"], ["Release notes", "s-idle", "Idle", "Hosted model", 8, "3 d ago"]].forEach(([n, c, t, m, runs, last]) => {
    const tr = el("tr"); const st = el("td"); st.appendChild(badge(c, t));
    const r = el("td", "right num", fmt.format(runs));
    tr.append(el("td", null, n), st, el("td", "muted", m), r, el("td", "muted", last));
    $("#agentRows").appendChild(tr);
  });

  /* Sample run. */
  [["s-ok", "Plan the task", "Research assistant · plan", "0.8 s"], ["s-ok", "Read three public pages", "web.read × 3", "4.2 s"], ["s-retry", "Summarise findings", "model.call · try 2 of 3", "6.1 s"], ["s-queued", "Ask to save the summary", "approval.request", "—"]].forEach(([c, title, sub, ms], i) => {
    const li = el("li", "step"), idx = el("span", "idx num", String(i + 1)), what = el("div", "what");
    what.append(el("b", null, title), el("span", null, sub));
    const right = el("div", "row"); right.append(badge(c, STATUS.find(s => s[0] === c)[1]), el("span", "num subtle t-caption", ms));
    li.append(idx, what, right); $("#steps").appendChild(li);
  });
  const LOG = ["12:04:01  plan       3 steps, budget 20 steps", "12:04:02  web.read   200  1.4 s", "12:04:04  web.read   200  1.3 s", "12:04:05  web.read   200  1.5 s", "12:04:11  model.call timeout after 6 s, retry in 2 s", "12:04:13  model.call try 2 of 3 …"];
  LOG.forEach((line, i) => { const ln = el("span", "ln", String(i + 1).padStart(2, "0") + "  "); $("#logs").append(ln, document.createTextNode(line + (i < LOG.length - 1 ? "\n" : ""))); });

  /* Tabs: APG automatic activation, arrows mirrored in RTL. */
  const tabs = $$("#tabs [role=tab]");
  function selectTab(t) {
    tabs.forEach(x => { const on = x === t; x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1; $("#" + x.getAttribute("aria-controls")).hidden = !on; });
    t.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => selectTab(t));
    t.addEventListener("keydown", e => {
      const rtl = root.dir === "rtl";
      const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
      if (next) { e.preventDefault(); selectTab(tabs[(i + next + tabs.length) % tabs.length]); }
      else if (e.key === "Home") { e.preventDefault(); selectTab(tabs[0]); }
      else if (e.key === "End") { e.preventDefault(); selectTab(tabs[tabs.length - 1]); }
    });
  });

  /* Toasts. */
  const TOAST = { info: ["s-queued", "Run queued (design sample)."], ok: ["s-ok", "Agent saved (design sample)."], retry: ["s-retry", "Model slow. Retrying in 2 seconds (design sample)."], failed: ["s-failed", "Run failed at step 3. Open the run to see why (design sample)."] };
  function toast(kind, text) {
    const t = el("div", "toast"), d = el("span", "dot " + (TOAST[kind] ? TOAST[kind][0] : "s-queued"));
    d.setAttribute("aria-hidden", "true");
    t.append(d, el("p", null, text || TOAST[kind][1]));
    const close = el("button", "btn btn-ghost btn-sm", "Dismiss"); close.type = "button";
    t.appendChild(close); $("#toasts").appendChild(t);
    let timer = setTimeout(() => t.remove(), 5000);
    const pause = () => clearTimeout(timer), resume = () => { timer = setTimeout(() => t.remove(), 5000); };
    t.addEventListener("mouseenter", pause); t.addEventListener("mouseleave", resume);
    t.addEventListener("focusin", pause); t.addEventListener("focusout", resume);
    close.addEventListener("click", () => t.remove());
  }
  $$("[data-toast]").forEach(b => b.addEventListener("click", () => toast(b.dataset.toast)));

  /* Loading button keeps its label for screen readers. */
  const save = $("#saveBtn");
  save.addEventListener("click", () => {
    if (save.getAttribute("aria-busy") === "true") return;
    save.setAttribute("aria-busy", "true");
    const sp = el("span", "spinner"); sp.setAttribute("aria-hidden", "true"); save.prepend(sp);
    setTimeout(() => { sp.remove(); save.removeAttribute("aria-busy"); toast("ok"); }, 1200);
  });

  /* Secret reveal. */
  const reveal = $("#revealBtn"), key = $("#f-key");
  reveal.addEventListener("click", () => { const show = key.type === "password"; key.type = show ? "text" : "password"; reveal.setAttribute("aria-pressed", String(show)); reveal.setAttribute("aria-label", show ? "Hide value" : "Show value"); });

  /* Dialogs: focus returns to the opener. */
  let opener = null;
  function openDialog(d, from) { opener = from || document.activeElement; d.showModal(); }
  $$("dialog").forEach(d => {
    d.addEventListener("close", () => { if (opener && opener.focus) opener.focus(); });
    $$("[data-close]", d).forEach(b => b.addEventListener("click", () => { d.close(); if (b.dataset.done) toast("ok", b.dataset.done); }));
  });
  $("#dangerBtn").addEventListener("click", e => openDialog($("#confirm"), e.currentTarget));
  $("#rejectBtn").addEventListener("click", e => openDialog($("#reject"), e.currentTarget));
  $("#approveBtn").addEventListener("click", () => toast("ok", "Action approved (design sample)."));

  /* Command palette: APG combobox in a modal dialog. */
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || "");
  $("#kbdHint").textContent = isMac ? "⌘ K" : "Ctrl K";
  $("#searchBtn").setAttribute("aria-label", isMac ? "Search (⌘K)" : "Search (Ctrl+K)");
  const pal = $("#palette"), palIn = $("#palInput"), palList = $("#palList"), palNone = $("#palNone");
  const CMDS = [["Overview", "Page", "#overview"], ["Agents", "Page", "#agents"], ["Workflows", "Page", "#workflows"], ["Runs", "Page", "#runs"], ["Approvals", "Page", "#approvals"], ["Design system", "Page", "#foundations"], ["Switch theme", "Action", "theme"], ["Switch direction", "Action", "dir"], ["New agent", "Action", "new"]];
  let shown = [], active = 0;
  function renderPal() {
    const q = palIn.value.trim().toLowerCase();
    // Match words against the command name only, at word starts, so "ag" finds Agents but not "Page".
    shown = CMDS.filter(c => q.split(/\s+/).every(w => c[0].toLowerCase().split(/\s+/).some(n => n.startsWith(w))));
    active = Math.min(active, Math.max(0, shown.length - 1));
    palList.replaceChildren();
    shown.forEach((c, i) => {
      const li = el("li"); li.id = "cmd-" + i; li.setAttribute("role", "option"); li.setAttribute("aria-selected", String(i === active));
      li.append(el("span", null, c[0]), el("span", "kind", c[1]));
      li.addEventListener("click", () => runCmd(c));
      li.addEventListener("mousemove", () => { if (active !== i) { active = i; renderPal(); } });
      palList.appendChild(li);
    });
    palNone.hidden = shown.length > 0;
    if (shown.length) palIn.setAttribute("aria-activedescendant", "cmd-" + active); else palIn.removeAttribute("aria-activedescendant");
  }
  function runCmd(c) {
    pal.close();
    if (c[2] === "theme") themeBtn.click();
    else if (c[2] === "dir") dirBtn.click();
    else if (c[2] === "new") toast("info", "Would open the agent editor (design sample).");
    else { const t = $(c[2]); if (t) t.scrollIntoView({ block: "start" }); }
  }
  function openPal(from) { palIn.value = ""; active = 0; renderPal(); openDialog(pal, from); palIn.focus(); }
  palIn.addEventListener("input", () => { active = 0; renderPal(); });
  palIn.addEventListener("keydown", e => {
    if (e.key === "ArrowDown" && shown.length) { e.preventDefault(); active = (active + 1) % shown.length; renderPal(); $("#cmd-" + active).scrollIntoView({ block: "nearest" }); }
    else if (e.key === "ArrowUp" && shown.length) { e.preventDefault(); active = (active - 1 + shown.length) % shown.length; renderPal(); $("#cmd-" + active).scrollIntoView({ block: "nearest" }); }
    else if (e.key === "Enter" && shown[active]) { e.preventDefault(); runCmd(shown[active]); }
  });
  pal.addEventListener("click", e => { if (e.target === pal) pal.close(); });
  $("#searchBtn").addEventListener("click", e => openPal(e.currentTarget));
  $("#paletteBtn2").addEventListener("click", e => openPal(e.currentTarget));

  /* Global keys: Ctrl/⌘+K, Esc closes the drawer. */
  document.addEventListener("keydown", e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); if (!pal.open) openPal(document.activeElement); }
    else if (e.key === "Escape" && app.classList.contains("drawer-open")) drawer(false);
  });
})();
</script>
</body>
</html>
