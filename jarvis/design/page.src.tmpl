<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'sha256-PIN'; style-src 'sha256-PIN'; font-src data:; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" />
<meta name="color-scheme" content="dark light" />
<title>Jarvis · Design system</title>
<style>
/*@FONTS@*/
/*@TOKENS@*/
:root {
  --sb: var(--layout-sidebar);
  --hairline: 1px;
}
@media (min-resolution: 2dppx) { :root { --hairline: 0.5px; } }
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
  margin: 0; min-height: 100dvh; background: var(--color-bg); color: var(--color-text);
  font: var(--text-base--font-weight) var(--text-base)/var(--text-base--line-height) var(--font-sans);
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
:lang(ar) body, [dir="rtl"] body { font-family: var(--font-arabic); }
h1, h2, h3 { margin: 0; text-wrap: balance; }
p { margin: 0; text-wrap: pretty; }
button, input, select, textarea { font: inherit; color: inherit; }
.mono, code, .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums slashed-zero; }
.num { direction: ltr; unicode-bidi: isolate; }
[dir="rtl"] .mono { direction: ltr; text-align: right; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.skip { position: absolute; inset-inline-start: 8px; top: -48px; z-index: 50; padding: 8px 12px; border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-on-accent); text-decoration: none; font-weight: 600; }
.skip:focus { top: 8px; }
:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
svg.i { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

/* ── Shell (S01) ───────────────────────────────────────────── */
.app { display: grid; grid-template-columns: var(--sb) minmax(0, 1fr); min-height: 100dvh; }
.app.rail { --sb: var(--layout-sidebar-rail); }
.sidebar {
  position: sticky; top: 0; height: 100dvh; display: flex; flex-direction: column; gap: 8px;
  padding: 12px 8px calc(12px + env(safe-area-inset-bottom)); background: var(--color-surface);
  border-inline-end: var(--hairline) solid var(--color-border); overflow-y: auto; overflow-x: hidden;
}
.brand { display: flex; align-items: center; gap: 10px; height: 40px; padding-inline: 8px; font-weight: 700; font-size: var(--text-headline); letter-spacing: -0.01em; }
.brand svg { width: 24px; height: 24px; flex: none; }
.nav { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
.nav a {
  position: relative; display: flex; align-items: center; gap: 12px; min-height: 36px; padding: 0 10px;
  border-radius: var(--radius-sm); color: var(--color-text-muted); text-decoration: none;
  font-size: var(--text-sm); font-weight: 500; white-space: nowrap;
}
.nav a:hover { background: var(--color-surface-raised); color: var(--color-text); }
.nav a[aria-current="page"] { color: var(--color-accent); background: var(--color-surface-raised); }
.nav a[aria-current="page"]::before { content: ""; position: absolute; inset-inline-start: -8px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--color-accent); }
.nav .count { margin-inline-start: auto; min-width: 22px; padding: 0 6px; border-radius: var(--radius-pill); background: var(--color-surface-sunken); color: var(--color-approval); font-size: var(--text-caption); line-height: 20px; text-align: center; }
.nav-label { overflow: hidden; text-overflow: ellipsis; }
.nav-group { margin: 12px 10px 4px; color: var(--color-text-subtle); font-size: var(--text-caption); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }
.sidebar-foot { margin-top: auto; display: grid; gap: 2px; }
.sidebar .collapse-btn { justify-content: flex-start; padding: 0 10px; }
.app.rail .nav-label, .app.rail .nav-group, .app.rail .brand-word, .app.rail .nav .count { display: none; }
.app.rail .nav a, .app.rail .sidebar .collapse-btn { justify-content: center; padding: 0; }
.app.rail .collapse-btn svg { transform: scaleX(-1); }
[dir="rtl"] .collapse-btn svg { transform: scaleX(-1); }
[dir="rtl"] .app.rail .collapse-btn svg { transform: none; }
.scrim { position: fixed; inset: 0; z-index: 30; background: rgb(0 0 0 / 0.5); }

.main-col { min-width: 0; display: flex; flex-direction: column; }
.topbar {
  position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 8px;
  height: var(--layout-header); padding: 0 16px; padding-top: env(safe-area-inset-top);
  background: var(--color-bg); border-bottom: var(--hairline) solid var(--color-border);
}
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .topbar, .sidebar { box-shadow: inset 0 1px 0 var(--color-glass-rim); background: var(--color-glass); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate)); backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate)); }
}
.topbar .spacer { flex: 1; }
.topbar .menu-btn { display: none; }
.topbar .search-trigger { min-width: 0; flex: 0 1 320px; justify-content: space-between; color: var(--color-text-subtle); font-weight: 500; }
.search-trigger .kbd { font-family: var(--font-mono); font-size: var(--text-caption); padding: 0 6px; border: var(--hairline) solid var(--color-border); border-radius: var(--radius-xs); color: var(--color-text-muted); }
.ws { position: relative; }
.ws-menu { position: absolute; z-index: 25; inset-inline-start: 0; top: calc(100% + 6px); min-width: 220px; padding: 6px; margin: 0; list-style: none; background: var(--color-surface-raised); border: var(--hairline) solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-pop); }
.ws-menu [role="menuitemradio"] { display: flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 10px; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--text-sm); }
.ws-menu [role="menuitemradio"]:hover, .ws-menu [role="menuitemradio"]:focus { background: var(--color-surface-sunken); outline: none; }
.ws-menu [aria-checked="true"]::after { content: "✓"; margin-inline-start: auto; color: var(--color-accent); }

main { width: 100%; max-width: var(--layout-content-max); margin-inline: auto; padding: 24px 24px calc(48px + env(safe-area-inset-bottom)); display: grid; gap: 32px; }
.page-head { display: grid; gap: 8px; }
.page-head h1 { font-size: var(--text-title); line-height: var(--text-title--line-height); font-weight: var(--text-title--font-weight); }
.sample-note { display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 4px 10px; border-radius: var(--radius-pill); background: var(--color-surface); border: var(--hairline) solid var(--color-border); color: var(--color-warning); font-size: var(--text-caption); font-weight: 500; }
.muted { color: var(--color-text-muted); }
.subtle { color: var(--color-text-subtle); }
section.block { display: grid; gap: 16px; scroll-margin-top: calc(var(--layout-header) + 16px); }
section.block > h2 { font-size: var(--text-headline); line-height: var(--text-headline--line-height); font-weight: 600; }
.card { background: var(--color-surface); border: var(--hairline) solid var(--color-border); border-radius: var(--radius-lg); padding: 8px; box-shadow: var(--shadow-card); }
.card-in { padding: 12px; border-radius: var(--radius-md); }
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.stack { display: grid; gap: 12px; }
.grid-2 { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }

/* Swatches */
.swatches { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 168px), 1fr)); }
.swatch { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 10px; align-items: center; padding: 8px; border-radius: var(--radius-md); background: var(--color-surface); border: var(--hairline) solid var(--color-border); }
.chip { width: 36px; height: 36px; border-radius: var(--radius-sm); border: var(--hairline) solid var(--color-border); }
.swatch b { display: block; font-size: var(--text-sm); font-weight: 600; overflow-wrap: anywhere; }
.swatch span { display: block; font-size: var(--text-caption); color: var(--color-text-muted); }

/* Type */
.type-row { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 8px 12px; }
.type-row + .type-row { border-top: var(--hairline) solid var(--color-border); }
.t-caption { font-size: var(--text-caption); line-height: var(--text-caption--line-height); font-weight: 500; }
.t-sm { font-size: var(--text-sm); line-height: var(--text-sm--line-height); }
.t-base { font-size: var(--text-base); line-height: var(--text-base--line-height); }
.t-headline { font-size: var(--text-headline); line-height: var(--text-headline--line-height); font-weight: 600; }
.t-title { font-size: var(--text-title); line-height: var(--text-title--line-height); font-weight: 650; }
.t-display { font-size: var(--text-display); line-height: var(--text-display--line-height); font-weight: 700; }

/* Button */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 36px; padding: 0 14px;
  border-radius: var(--radius-sm); border: var(--hairline) solid transparent; cursor: pointer;
  font-size: var(--text-sm); font-weight: 600; white-space: nowrap; text-decoration: none;
  transition: transform var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease);
}
.btn:active:not(:disabled) { transform: scale(0.97); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.btn-primary { background: var(--color-accent); color: var(--color-on-accent); }
.btn-primary:hover:not(:disabled) { background: var(--color-accent-hover); }
.btn-secondary { background: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border); }
.btn-secondary:hover:not(:disabled) { border-color: var(--color-border-input); }
.btn-ghost { background: transparent; color: var(--color-text-muted); }
.btn-ghost:hover:not(:disabled) { background: var(--color-surface-raised); color: var(--color-text); }
.btn-danger { background: var(--color-danger); color: var(--color-on-danger); }
.btn-sm { min-height: 32px; padding: 0 10px; }
.btn-lg { min-height: 44px; padding: 0 18px; font-size: var(--text-base); }
.btn-icon { width: 36px; padding: 0; }
.btn[aria-busy="true"] { cursor: progress; }
.spinner { width: 14px; height: 14px; border-radius: 50%; border: 2px solid currentColor; border-inline-end-color: transparent; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* Fields */
.field { display: grid; gap: 6px; min-width: 0; }
.field label, .legend { font-size: var(--text-sm); font-weight: 500; }
.hint { font-size: var(--text-caption); color: var(--color-text-subtle); }
.err { display: flex; align-items: center; gap: 6px; font-size: var(--text-caption); color: var(--color-danger); }
.input, .select, .textarea {
  width: 100%; min-height: 36px; padding: 0 12px; border-radius: var(--radius-sm);
  background: var(--color-surface-sunken); border: 1px solid var(--color-border-input); color: var(--color-text);
}
.textarea { padding: 8px 12px; min-height: 88px; resize: vertical; }
.input::placeholder, .textarea::placeholder { color: var(--color-text-subtle); opacity: 1; }
.input:hover:not(:disabled), .select:hover:not(:disabled) { border-color: var(--color-text-subtle); }
.input:focus-visible, .select:focus-visible, .textarea:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 1px; border-color: var(--color-focus); }
.input[aria-invalid="true"] { border-color: var(--color-danger); }
.input:disabled, .select:disabled { opacity: 0.5; cursor: not-allowed; }
.with-icon { position: relative; }
.with-icon svg { position: absolute; inset-inline-start: 10px; top: 50%; translate: 0 -50%; width: 16px; height: 16px; color: var(--color-text-subtle); pointer-events: none; }
.with-icon .input { padding-inline-start: 34px; }
.secret { display: flex; gap: 8px; }
fieldset { margin: 0; padding: 0; border: 0; display: grid; gap: 10px; min-width: 0; }
.check { display: flex; align-items: center; gap: 10px; font-size: var(--text-sm); cursor: pointer; }
.check input { width: 18px; height: 18px; margin: 0; accent-color: var(--color-accent); }
.switch input { appearance: none; -webkit-appearance: none; position: relative; width: 36px; height: 20px; margin: 0; border-radius: var(--radius-pill); background: var(--color-surface-sunken); border: 1px solid var(--color-border-input); cursor: pointer; }
.switch input::after { content: ""; position: absolute; top: 2px; inset-inline-start: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-text-muted); transition: transform var(--motion-base) var(--motion-ease); }
.switch input:checked { background: var(--color-accent); border-color: var(--color-accent); }
.switch input:checked::after { transform: translateX(16px); background: var(--color-on-accent); }
[dir="rtl"] .switch input:checked::after { transform: translateX(-16px); }
.switch input:disabled { opacity: 0.5; cursor: not-allowed; }

/* Tabs */
.tablist { display: flex; gap: 4px; border-bottom: var(--hairline) solid var(--color-border); overflow-x: auto; scrollbar-width: none; }
.tab { position: relative; min-height: 40px; padding: 0 12px; border: 0; background: none; color: var(--color-text-muted); cursor: pointer; font-size: var(--text-sm); font-weight: 500; white-space: nowrap; }
.tab:hover { color: var(--color-text); }
.tab[aria-selected="true"] { color: var(--color-text); }
.tab[aria-selected="true"]::after { content: ""; position: absolute; inset-inline: 8px; bottom: -1px; height: 2px; border-radius: 2px; background: var(--color-accent); }
.tabpanel { padding-top: 12px; font-size: var(--text-sm); }

/* Status */
.badge { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; border-radius: var(--radius-pill); background: var(--color-surface-sunken); border: var(--hairline) solid var(--color-border); font-size: var(--text-caption); font-weight: 500; white-space: nowrap; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: none; }
.s-idle { color: var(--color-text-subtle); }
.s-running, .s-ok { color: var(--color-success); }
.s-failed { color: var(--color-danger); }
.s-queued { color: var(--color-info); }
.s-retry { color: var(--color-warning); }
.s-approval { color: var(--color-approval); }
.s-paused { color: var(--color-text-muted); }
.s-running .dot { animation: pulse 1.6s var(--motion-ease) infinite; }
@keyframes pulse { 50% { opacity: 0.4; } }

/* Stat tiles */
.stats { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
.stat { display: grid; gap: 4px; padding: 16px; border-radius: var(--radius-md); background: var(--color-surface); border: var(--hairline) solid var(--color-border); }
.stat .label { font-size: var(--text-caption); font-weight: 500; color: var(--color-text-muted); }
.stat .value { font-size: var(--text-display); line-height: var(--text-display--line-height); font-weight: 700; }
.stat .delta { font-size: var(--text-caption); }

/* Table */
.table-scroll { overflow-x: auto; border-radius: var(--radius-md); border: var(--hairline) solid var(--color-border); background: var(--color-surface); }
table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
th, td { height: var(--layout-row); padding: 0 12px; text-align: start; white-space: nowrap; border-bottom: var(--hairline) solid var(--color-border); }
th { font-size: var(--text-caption); font-weight: 500; color: var(--color-text-muted); background: var(--color-surface); }
tbody tr:hover { background: var(--color-surface-raised); }
tbody tr:last-child td { border-bottom: 0; }
td.right, th.right { text-align: end; }

/* Timeline */
.timeline { list-style: none; margin: 0; padding: 0; display: grid; }
.step { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 12px; border-bottom: var(--hairline) solid var(--color-border); }
.step:last-child { border-bottom: 0; }
.step .idx { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--color-surface-sunken); font-size: var(--text-caption); }
.step .what { min-width: 0; display: grid; }
.step .what b { font-size: var(--text-sm); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.step .what span { font-size: var(--text-caption); color: var(--color-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.log { margin: 0; padding: 12px; border-radius: var(--radius-md); background: var(--color-surface-sunken); font-family: var(--font-mono); font-size: var(--text-caption); line-height: 20px; color: var(--color-text-muted); overflow-x: auto; white-space: pre; direction: ltr; text-align: left; }
.log .ln { color: var(--color-text-subtle); }

/* Approval */
.approval { display: grid; gap: 12px; padding: 16px; border-radius: var(--radius-md); background: var(--color-surface); border: var(--hairline) solid var(--color-border); }
.approval.locked { border-style: dashed; }
.approval h3 { font-size: var(--text-headline); font-weight: 600; }
.diff { margin: 0; padding: 10px 12px; border-radius: var(--radius-sm); background: var(--color-surface-sunken); font-family: var(--font-mono); font-size: var(--text-caption); line-height: 20px; white-space: pre-wrap; overflow-wrap: anywhere; direction: ltr; text-align: left; }
.diff .add { color: var(--color-success); }
.diff .del { color: var(--color-danger); }

/* Empty + skeleton */
.empty { display: grid; justify-items: center; gap: 8px; padding: 32px 16px; text-align: center; border: 1px dashed var(--color-border); border-radius: var(--radius-md); }
.empty svg { width: 32px; height: 32px; color: var(--color-text-subtle); }
.empty h3 { font-size: var(--text-headline); font-weight: 600; }
.skel { display: grid; gap: 10px; padding: 16px; border-radius: var(--radius-md); background: var(--color-surface); border: var(--hairline) solid var(--color-border); }
.sk { height: 12px; border-radius: 6px; background: var(--color-surface-raised); animation: shimmer 1.4s var(--motion-ease) infinite; }
.sk.w60 { width: 60%; } .sk.w80 { width: 80%; } .sk.w40 { width: 40%; } .sk.h32 { height: 32px; width: 32%; }
@keyframes shimmer { 50% { opacity: 0.5; } }

/* Dialog + palette */
dialog { width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 64px); padding: 0; border: var(--hairline) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-raised); color: var(--color-text); box-shadow: var(--shadow-pop); }
dialog::backdrop { background: rgb(0 0 0 / 0.55); }
.dlg { display: grid; gap: 16px; padding: 20px; }
.dlg h2 { font-size: var(--text-headline); font-weight: 600; }
.dlg .actions { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
.palette { margin-top: 12dvh; }
.palette .pal-in { display: flex; align-items: center; gap: 10px; padding: 0 16px; border-bottom: var(--hairline) solid var(--color-border); }
.palette .pal-in svg { color: var(--color-text-subtle); }
.palette input { flex: 1; min-width: 0; height: 52px; border: 0; background: none; font-size: var(--text-headline); outline: none; }
.palette input::placeholder { color: var(--color-text-subtle); opacity: 1; }
.palette ul { list-style: none; margin: 0; padding: 6px; max-height: 50dvh; overflow-y: auto; }
.palette li { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 10px; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--text-sm); }
.palette li[aria-selected="true"] { background: var(--color-surface-sunken); color: var(--color-accent); }
.palette li .kind { margin-inline-start: auto; color: var(--color-text-subtle); font-size: var(--text-caption); }
.palette .none { padding: 16px; color: var(--color-text-muted); font-size: var(--text-sm); }

/* Toasts */
.toasts { position: fixed; z-index: 60; inset-inline-end: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); display: grid; gap: 8px; width: min(360px, calc(100vw - 32px)); }
.toast { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: var(--radius-md); background: var(--color-surface-raised); border: var(--hairline) solid var(--color-border); box-shadow: var(--shadow-pop); font-size: var(--text-sm); animation: toast-in var(--motion-base) var(--motion-ease); }
.toast .dot { margin-top: 6px; }
.toast p { flex: 1; min-width: 0; }
@keyframes toast-in { from { opacity: 0; transform: translateY(8px); } }

/* ── Responsive shell ─────────────────────────────────────── */
@media (min-width: 768px) and (max-width: 1279px) { .app { --sb: var(--layout-sidebar-rail); } .app .nav-label, .app .nav-group, .app .brand-word, .app .nav .count { display: none; } .app .nav a { justify-content: center; padding: 0; } .sidebar .collapse-btn { display: none; } }
@media (max-width: 767px) {
  .app { grid-template-columns: minmax(0, 1fr); }
  .sidebar { position: fixed; z-index: 40; inset-block: 0; inset-inline-start: 0; width: min(280px, 85vw); transform: translateX(-100%); visibility: hidden; transition: transform var(--motion-base) var(--motion-ease), visibility 0s linear var(--motion-base); }
  [dir="rtl"] .sidebar { transform: translateX(100%); }
  .app.drawer-open .sidebar { transform: none; visibility: visible; transition: transform var(--motion-base) var(--motion-ease); }
  .topbar .menu-btn { display: inline-flex; }
  .sidebar .collapse-btn { display: none; }
  .search-trigger .search-word, .search-trigger .kbd { display: none; }
  .topbar .search-trigger { flex: none; width: 36px; padding: 0; justify-content: center; }
  .ws-name { max-width: 30vw; overflow: hidden; text-overflow: ellipsis; }
  main { padding: 16px 16px calc(48px + env(safe-area-inset-bottom)); gap: 24px; }
  .type-row { grid-template-columns: 72px minmax(0, 1fr); }
}
@media (pointer: coarse) {
  .btn, .btn-sm, .input, .select, .nav a, .tab, .palette li, .ws-menu [role="menuitemradio"] { min-height: 44px; }
