      <button class="btn btn-ghost btn-icon" id="themeBtn" type="button" aria-label="Switch to light theme"><svg class="i" aria-hidden="true"><use href="#i-sun" id="themeIcon"/></svg></button>
    </header>
    <main id="main" tabindex="-1" aria-live="polite" aria-busy="false"></main>
  </div>
