        <ul class="ws-menu glass" id="wsMenu" role="menu" aria-label="Workspaces" hidden></ul>
      </div>
      <button class="btn btn-secondary search-trigger" id="searchBtn" type="button" aria-label="Search (Ctrl+K)" aria-haspopup="dialog">
