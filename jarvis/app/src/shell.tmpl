<dialog id="palette" class="palette glass" aria-label="Command palette">
  <div class="pal-in">
    <svg class="i" aria-hidden="true"><use href="#i-search"/></svg>
    <input id="palInput" type="text" name="command" autocomplete="off" placeholder="Jump to a page or run an action…" role="combobox" aria-expanded="true" aria-controls="palList" aria-autocomplete="list" aria-label="Command" />
  </div>
  <ul id="palList" class="pal-list" role="listbox" aria-label="Results"></ul>
  <p class="pal-none" id="palNone" hidden>No match. Try a page, an agent or an action.</p>
</dialog>
<dialog id="dlg" aria-labelledby="dlgTitle"></dialog>
<div class="toasts" id="toasts" role="status" aria-live="polite"></div>

