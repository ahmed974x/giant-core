# Where the OMEGA relay listens on this machine (docker compose maps it to 127.0.0.1:8088).
RELAY_URL=http://127.0.0.1:8088
# Optional live layers on the Earth screen (both keys are free). Put real values in web/.env.local, never in git.
AISSTREAM_API_KEY=
WINDY_WEBCAMS_KEY=
NASA_FIRMS_KEY=
# 6+ digit PIN that lets the web/phone approve Director 00 proposals; empty = read-only inbox
DIRECTOR_WEB_PIN=

# Page reader for links sent from the phone (ADR-026). Optional: with a key, links are read by Firecrawl cloud
# (the URL leaves the laptop; free tier 1,000 pages/month). Without it, a local reader handles normal web pages.
FIRECRAWL_API_KEY=

# Immich (ADR-030): set after Immich runs; create an API key in Immich > Account settings > API keys.
# Must be this laptop (127.0.0.1); the key never leaves the server.
IMMICH_URL=http://127.0.0.1:2283
IMMICH_API_KEY=

# Deep Research (ADR-061): free, open sources and models only. SearXNG must have the JSON format enabled
# (settings.yml: search.formats: [html, json]). Cortex is used when OMEGA_GATEWAY_TOKEN is set; Ollama is the fallback.
SEARXNG_URL=http://127.0.0.1:8890
CORTEX_URL=http://127.0.0.1:8089/v1
OMEGA_GATEWAY_TOKEN=
DEEP_RESEARCH_MODEL=omega/oracle
OLLAMA_URL=http://127.0.0.1:11434/v1
DEEP_RESEARCH_LOCAL_MODEL=qwen2.5:3b
# Optional: your email puts OpenAlex requests in its faster "polite pool"
OPENALEX_MAILTO=

# Accounts for the paper platform (ADR-075, NextAuth). All empty = accounts off; the owner keeps using the PIN.
# NEXTAUTH_SECRET: 32+ random characters (e.g. `openssl rand -base64 32`). NEXTAUTH_URL: the address people use.
# Provider ids/secrets come from the provider's developer settings. Put real values in web/.env.local, never in git.
# Google is the primary sign-in (docs/LOCAL-SETUP-AR.md has the Google Cloud steps); GitHub is optional.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Daily paper briefing email (ADR-075): placeholder only, nothing is sent yet. The project's own address (not a
# personal one), a sender, and BRIEFING_EMAIL_APPROVED=yes only after a test send is approved.
BRIEFING_EMAIL_TO=
BRIEFING_EMAIL_FROM=
BRIEFING_SMTP_URL=
BRIEFING_EMAIL_APPROVED=
