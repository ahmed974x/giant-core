# Where the OMEGA relay listens on this machine (docker compose maps it to 127.0.0.1:8088).
RELAY_URL=http://127.0.0.1:8088
# Optional live layers on the Earth screen (both keys are free). Put real values in web/.env.local, never in git.
AISSTREAM_API_KEY=
WINDY_WEBCAMS_KEY=
NASA_FIRMS_KEY=
# 6+ digit PIN that lets the web/phone approve Director 00 proposals; empty = read-only inbox
DIRECTOR_WEB_PIN=
