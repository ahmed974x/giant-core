{
  "name": "omega-web",
  "private": true,
  "version": "0.1.0",
  "description": "OMEGA PRIME four-screen web app (Company, Market, Research, Earth), Arabic/English",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/secure-run.mjs dev -p 3100",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/secure-run.mjs build",
    "start": "node scripts/secure-run.mjs start -p 3100 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\"",
    "atlas:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/atlas-sync.ts",
    "e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"e2e/**/*.e2e.ts\"",
    "briefing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/briefing.ts",
    "secrets:encrypt": "node scripts/secrets.mjs encrypt",
    "secrets:set": "node scripts/secrets.mjs set",
    "secrets:check": "node scripts/secrets.mjs check",
    "secrets:test": "node scripts/secrets.mjs test",
    "secrets:backup": "node scripts/secrets.mjs backup",
    "keys:vault": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/keys-vault.mjs"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.75.1",
    "@types/pg": "8.15.5",
    "@xyflow/react": "12.12.0",
    "lightweight-charts": "5.2.1",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
