              "enum": [
                "wikipedia",
                "openalex",
                "crossref",
                "europepmc",
                "arxiv",
                "semanticscholar",
                "gdelt",
                "wayback",
                "doaj",
                "dblp",
                "wikidata",
                "nvd",
                "clinicaltrials",
                "pubmed",
                "zenodo",
                "osti",
                "epss"
              ]
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "the upstream API address",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
