{
  "openapi": "3.1.0",
  "info": {
    "title": "OMEGA local data proxy",
    "version": "1.17.0",
    "summary": "Free, keyless public data for the OMEGA pages, cached on disk and bound to 127.0.0.1.",
    "description": "scripts/omega-data-proxy.mjs (ADR-089 to ADR-122). GET only except the local model bridge. CORS is added for local pages only; any other Origin gets 403 and an unknown Host gets 421. Every route reads one fixed public upstream; nothing here signs, sends or routes an order, holds a key or writes outside its cache. Generated Markdown: docs/api/OMEGA-DATA-PROXY-API.md (node scripts/build-api-docs.mjs). Every answer carries X-Content-Type-Options nosniff, Referrer-Policy no-referrer, Cross-Origin-Opener-Policy same-origin and Cross-Origin-Resource-Policy same-site; the private-network grant goes to http(s) loopback origins only, and a client that has not sent its headers within 10 s is cut off (ADR-122, found by scripts/self-shield.mjs). OMEGA_OFFLINE=1 refuses every upstream call (the self-shield sandbox).",
    "license": {
      "name": "Data under each upstream's own terms; see the footer of each page"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8796",
      "description": "local proxy (./start-omega.sh or start-omega.bat)"
    }
  ],
  "tags": [
    {
      "name": "meta"
    },
    {
      "name": "filings"
    },
    {
      "name": "market"
    },
    {
      "name": "osiris"
    },
    {
      "name": "cyber"
    },
    {
      "name": "research"
    },
    {
      "name": "local model"
    }
  ],
