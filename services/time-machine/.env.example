# Time Machine Service Configuration
# Copy this file to .env.time-machine and adjust values as needed

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omega_prime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omega_prime

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Time Machine Streams
TIME_MACHINE_COMMAND_STREAM=omega:simulation:commands
TIME_MACHINE_RESULT_STREAM=omega:simulation:results

# Canwu Service
CANWU_HOST=0.0.0.0
CANWU_PORT=8081
CANWU_WORKERS=4

# Logging
LOG_LEVEL=info
RUST_LOG=info

# GDELT Ingestor
GDELT_API_URL=https://api.gdeltproject.org/api/v2/events/search
GDELT_DEFAULT_THEME=historical_event

# QuantReplay
QUANTREPLAY_URL=http://localhost:8080
QUANTREPLAY_TIMEOUT_SECONDS=300
