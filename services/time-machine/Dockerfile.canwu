#!/usr/bin/env python3
"""Minimal local Dockerfile for the Rust-based Canwu service."""

FROM rust:1.78-slim AS builder
WORKDIR /app

RUN cargo new --bin canwu
COPY . /app
RUN cargo build --release --bin canwu

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/canwu /usr/local/bin/canwu

ENV RUST_LOG=info
EXPOSE 8081

CMD ["canwu"]
