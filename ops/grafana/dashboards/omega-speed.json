      "datasource": {
        "type": "prometheus",
        "uid": "omega-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(omega_api_ms_bucket[1m])) by (le, agent))",
          "legendFormat": "{{agent}} p95",
          "refId": "{",
          "datasource": {
            "type": "prometheus",
            "uid": "omega-prom"
          }
        }
      ]
    }
  ]
